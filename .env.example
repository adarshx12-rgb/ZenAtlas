# Copy to .env and replace placeholders. No provider is needed for catalogue search.
DATABASE_URL=postgres://search_app:replace-with-app-password@127.0.0.1:5432/creator_search
MIGRATION_DATABASE_URL=postgres://postgres:replace-with-owner-password@127.0.0.1:5432/creator_search
POSTGRES_PASSWORD=replace-with-owner-password
APP_DATABASE_PASSWORD=replace-with-app-password
HOST=127.0.0.1
PORT=3000
PUBLIC_ORIGIN=http://127.0.0.1:3000
SESSION_SECRET=replace-with-at-least-32-random-characters
ADMIN_TOKEN=replace-with-at-least-32-random-characters
SEARXNG_BASE_URL=
SEARXNG_TOKEN=
# Each engine is asked in its own request, one request at a time per engine.
SEARXNG_ENGINES=youtube,dailymotion,sepiasearch,odysee,bing videos,google videos,duckduckgo videos,brave.videos,wikicommons.videos
SEARXNG_SOURCE_ENGINES=google,bing
# Engines for web-page searches (websites queries, and web searches planned by a deep dive).
SEARXNG_WEB_ENGINES=google,bing,brave,yahoo
# Deep dives also ask these engines, whose sources ordinary searches rarely reach.
SEARXNG_DEEP_ENGINES=bilibili,acfun,privacywall videos
SEARXNG_DEEP_WEB_ENGINES=yep,resulthunter,privacywall,hackernews
# Deep dive (2–3 minutes): AI-planned searches for lesser-known sources, result pages per search, new results kept,
# follow-up searches per round and rounds, and seconds of searching before the checks and AI ranking.
DEEP_PLAN_SEARCHES=6
DEEP_PAGES=2
DEEP_RESULTS=40
DEEP_FOLLOW_UPS=4
DEEP_ROUNDS=2
DEEP_SEARCH_SECONDS=120
# Check a shared pool after all launched sources finish; final display limits apply after judging.
DISCOVERY_CANDIDATES=60
# Optional Jev screening before evidence collection. Uses OPENROUTER_API_KEY below;
# false disables it. Missing key or failed screening preserves the existing order.
JEV_SCREENING_ENABLED=true
JEV_MODEL=typesafe/jev-1.13
# Samples half from the original shortlist and half across the remaining candidates.
JEV_SCREEN_CANDIDATES=120
# At most six concurrent batches of 20; budget counts HTTP calls, not candidates.
JEV_SCREEN_TIMEOUT_MS=4000
JEV_SCREEN_DAILY_BUDGET=600
JEV_SCREEN_CONFIDENCE=0.8
# Source/link exploration on quick and deep searches, using the same OpenRouter key.
# Also bounded by half of PAGE_CHECKS. Source-specific and site: queries skip exploration.
JEV_EXPLORATION_ENABLED=true
JEV_EXPLORATION_PAGES=4
JEV_EXPLORATION_ROUNDS=2
JEV_EXPLORATION_CANDIDATES=40
JEV_EXPLORATION_TIMEOUT_MS=4000
# Docs tab document hunt (docs/DOCS_SEARCH.md): after a Docs search, Jev looks inside up to DOC_HUNT_SITES websites the
# search found for the requested document (any format), following leads over DOC_HUNT_ROUNDS rounds and at most
# DOC_HUNT_VISITS pages within DOC_HUNT_TIMEOUT_MS; it stops after DOC_HUNT_MAX_DOCS documents. Everything found is
# reviewed by the Jev pre-judge and the LLM judge, and each website gets a verdict (document, on the page, buy/borrow, none).
DOC_HUNT_ENABLED=true
DOC_HUNT_SITES=6
DOC_HUNT_VISITS=14
DOC_HUNT_ROUNDS=3
DOC_HUNT_TIMEOUT_MS=20000
DOC_HUNT_MAX_DOCS=8
# Jev link and website decisions per day for document hunting, separate from JEV_EXPLORATION_DAILY_BUDGET.
JEV_DOC_HUNT_DAILY_BUDGET=400
# Web tab review (docs/WEB_SEARCH.md): every result page is read, Jev removes pages that miss the request or look
# unreliable (accuracy below WEB_JEV_ACCURACY_MIN), and the LLM judge ranks the rest. WEB_JEV_SETTLE=true lets Jev decide
# confident matches alone; decide from the web_review lines in the API log (settle_agreement).
WEB_REVIEW_ENABLED=true
WEB_REVIEW_READ_MS=15000
WEB_JEV_ACCURACY_MIN=0.3
WEB_JEV_SETTLE=false
# Login-free preview: web results from login-walled sites (data/login-walled.json) open in a preview window on the
# results page, filled only from official sources (X and Pinterest oEmbed) or readable page text. Reddit is not listed (its
# posts open without signing in); the Reddit keys are only needed if it is added back to data/login-walled.json.
WALLED_PREVIEW_ENABLED=true
WALLED_PREVIEW_DAILY_BUDGET=3000
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
# Mode routing: a new search opens on the tab its query suits. Format words decide first ("cat videos", "tax form pdf");
# otherwise Jev picks a mode when at least MODE_JEV_CONFIDENCE sure, else MODE_ROUTER_MODEL (OpenRouter) decides; all
# within MODE_ROUTER_TIMEOUT_MS, else videos. mode_route lines in the API log show which step decided.
MODE_ROUTER_ENABLED=true
MODE_JEV_CONFIDENCE=0.7
MODE_ROUTER_MODEL=google/gemini-3.5-flash-lite
MODE_ROUTER_TIMEOUT_MS=3000
MODE_ROUTER_DAILY_BUDGET=2000
# Free-document sources the Docs tab searches directly (arXiv, Semantic Scholar, Zenodo, DOAJ, Google Books full view,
# Internet Archive texts, user-upload viewers such as Scribd and SlideShare, and institutional repositories), and their
# combined daily call limit. Semantic Scholar rate-limits anonymous use; a free key raises the limit.
DOC_SOURCES_ENABLED=true
DOC_SOURCES_DAILY_BUDGET=1500
SEMANTIC_SCHOLAR_API_KEY=
# Public malware and phishing host lists (comma-separated https URLs) every Docs link is checked against, refreshed daily.
# The larger Phishing.Database list (https://phish.co.za/latest/phishing-domains-ACTIVE.txt, ~400k domains) can be added.
DOC_BLOCKLISTS=https://urlhaus.abuse.ch/downloads/hostfile/,https://raw.githubusercontent.com/openphish/public_feed/refs/heads/main/feed.txt
JEV_EXPLORATION_DAILY_BUDGET=200
JEV_EXPLORATION_CONFIDENCE=0.65
SPECIALIST_SEARCHES=3
# Direct, keyless film catalogue searches during deep discovery. Collections restrict archive noise.
ARCHIVE_DISCOVERY=true
ARCHIVE_COLLECTIONS=prelinger,ephemera
# Optional: the LoC API rejected this deployment's live check; enable only after verifying access.
LIBRARY_OF_CONGRESS_DISCOVERY=false
ARCHIVE_DAILY_BUDGET=200
# YouTube videos with more views are never marked as underrated finds.
UNDERRATED_MAX_VIEWS=50000
# SearXNG requests per day (self-hosted, so higher than DISCOVERY_DAILY_BUDGET, which also limits the paid Google API).
SEARXNG_DAILY_BUDGET=2000
# Docs tab previews: documents are fetched from their source and their first pages shown inside ZenAtlas. PDFs always preview.
# Word, PowerPoint, Excel and OpenDocument files need LibreOffice: set its soffice command (Linux: soffice; Windows:
# C:/Program Files/LibreOffice/program/soffice.com). Empty = those files open from their source instead. One conversion
# runs at a time (about 300 MB of RAM while it runs, 5-30 s each); previews are cached for a day in DOC_PREVIEW_CACHE_DIR
# (empty = the system temp folder) up to DOC_PREVIEW_CACHE_MB, and DOC_PREVIEW_DAILY_BUDGET caps uncached fetches.
DOC_PREVIEW_CONVERTER=
DOC_PREVIEW_CACHE_DIR=
DOC_PREVIEW_MAX_MB=25
DOC_PREVIEW_CACHE_MB=500
DOC_PREVIEW_DAILY_BUDGET=500
# Pages shown in a preview (0 = all). The whole document is one click away at its source: PDFs open there, other files download.
DOC_PREVIEW_PAGES=5
# Independent direct providers. Configure any combination; SearXNG is optional.
# Google Custom Search requires an existing eligible account (closed to new customers).
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_ENGINE_ID=
BRAVE_SEARCH_API_KEY=
PROVIDER_TIMEOUT_MS=12000
DISCOVERY_RESULTS=30
DISCOVERY_DAILY_BUDGET=100
# Brave Search API requests per day. Metered, so it has its own limit; check it against your Brave plan before raising it.
BRAVE_DAILY_BUDGET=250
COVERAGE_MIN_RESULTS=5
COVERAGE_MIN_SCORE=0.03
# Auto mode also runs discovery when strong catalogue matches come from fewer sites than this.
COVERAGE_MIN_SOURCES=3
SEARCH_TTL_SECONDS=1800
DISCOVERY_CACHE_SECONDS=600
SOURCE_REFRESH_HOURS=24
SOURCE_HEALTH_HOURS=6
SOURCE_HEALTH_RETRY_MINUTES=15
SOURCE_HEALTH_FAILURES=3
# Unreviewed candidate domains are probed this rarely (hours), so they cannot use up the budget approved sources need.
SOURCE_HEALTH_CANDIDATE_HOURS=168
SOURCE_HEALTH_DAILY_BUDGET=1000
# AI search planning: up to this many searches per request (the user's query is always one of them).
PLAN_SEARCHES=4
# Web results whose pages are opened (robots.txt is respected) to check their content and front-end libraries.
PAGE_CHECKS=20
PAGE_TIMEOUT_MS=6000
# Of those, the first PAGE_RENDERS are also opened in headless Chromium (0 = off). Install the browser first:
# npx playwright install --only-shell chromium. Rendering finds libraries loaded by scripts and takes a first-screen preview.
PAGE_RENDERS=0
PAGE_RENDER_TIMEOUT_MS=12000
# Python with the scene worker's pages extra (pip install -e "scene-worker[pages]") for main-content text via trafilatura,
# e.g. scene-worker/.venv/Scripts/python.exe on Windows or scene-worker/.venv/bin/python elsewhere. Empty = visible text only.
PAGE_TEXT_PYTHON=
# Optional JSON embedding service: POST {input,model}, response {embedding:number[]}.
EMBEDDING_URL=
EMBEDDING_TOKEN=
EMBEDDING_MODEL=
EMBEDDING_DIMENSIONS=384
EMBEDDING_DAILY_BUDGET=100
SEMANTIC_ENABLED=false
# Optional Compose discovery overlay. Select an actual digest from the official registry.
SEARXNG_IMAGE=
SEARXNG_SECRET=replace-with-random-searxng-secret
# Viewer signals (src/signals.ts). Official YouTube Data API v3 key from Google Cloud (free quota: 10,000 units/day).
YOUTUBE_API_KEY=
# Quota units this app may use per day; each video-details or comment request costs 1 unit.
YOUTUBE_DAILY_UNITS=3000
SIGNAL_VIDEOS=25
SIGNAL_COMMENTS=100
# Relevant/recent/reply samples share this per-video cap (maximum 300); each API page spends quota.
# PeerTube and Internet Archive evidence checks require the source's existing permissions.
VIDEO_EVIDENCE_CHECKS=12
# Queue up to three promising, permitted canonical videos for the separate Python worker.
SCENE_AUTO_QUEUE=true
SCENE_SHORTLIST=3
# Existing YouTube captions (docs/YOUTUBE_CAPTIONS.md): after each search, fetch captions in the background for up to
# YOUTUBE_CAPTIONS_SHORTLIST top YouTube results without a transcript, once per video. Creator captions are used when
# they exist, otherwise auto-generated ones. Only caption text is read, never audio or video. Needs the scene-worker
# "captions" extra: pip install -e "scene-worker[captions]".
YOUTUBE_CAPTIONS=false
YOUTUBE_CAPTIONS_SHORTLIST=5
# Caption jobs queued per day.
YOUTUBE_CAPTIONS_DAILY_BUDGET=200
# Python with the captions extra; empty uses PAGE_TEXT_PYTHON.
CAPTIONS_PYTHON=
# Optional http(s) proxy URL for caption requests. YouTube blocks many cloud and heavily used addresses.
YOUTUBE_CAPTIONS_PROXY=
# Supadata (supadata.ai) fetches the same captions from its own servers. Used only while YouTube blocks direct requests,
# one credit per video (never AI-generated transcripts). The free plan has 100 credits a month, about 3 a day.
SUPADATA_API_KEY=
SUPADATA_DAILY_BUDGET=3
# Comma-separated YouTube channel IDs to label "Official channel" and prefer for film/TV scene searches.
OFFICIAL_YOUTUBE_CHANNELS=
# Look up Reddit threads through SearXNG (SEARXNG_SOURCE_ENGINES) to see which videos people discuss.
REDDIT_SIGNALS=true
# Recognise a confidently matched anime via the public AniList API (no key needed), by title, then by character
# names for a request that only describes a scene, and give the AI planner and judge its official titles, synonyms,
# details and, for a specific scene, the likely episode, so searches and relevance checks use the real show.
ANILIST_ENABLED=true
# A query needing every recognition stage can cost up to 7 requests; self-hosted and free, so budgeted generously.
ANILIST_DAILY_BUDGET=2000
# AI relevance judgement uses GEMINI_API_KEY and GEMINI_MODEL below; at most this many calls per day.
# Model for AI planning and judging; empty uses GEMINI_MODEL.
JUDGE_MODEL=
# Comma-separated models tried in order when JUDGE_MODEL is overloaded, rate-limited or times out, e.g. gemini-3.6-flash.
JUDGE_FALLBACK_MODELS=
# Gemini reasoning effort for the judgement: minimal, low, medium, high, or model_default.
JUDGE_THINKING_LEVEL=low
# Models that rank results, tried in order on OpenRouter. They MUST accept images: website
# candidates are judged partly on a screenshot, and several models that advertise image input
# ignore it in practice, so verify before adding one. Empty leaves judging to Gemini; when models
# are named, Gemini judges only if they all fail.
JUDGE_MODELS=
# Learning loop (docs/LEARNING.md): a critic audits each discovery search on the OpenRouter key, and a reviewer
# re-checks a sample weekly. The budget counts critic calls per day (an audit makes at most two).
CRITIC_ENABLED=false
CRITIC_MODEL=anthropic/claude-sonnet-5
CRITIC_REVIEW_MODEL=anthropic/claude-sonnet-5
CRITIC_DAILY_BUDGET=40
CRITIC_TIMEOUT_MS=120000
CRITIC_PROBES=3
TRACE_RETENTION_DAYS=90
JUDGE_DAILY_BUDGET=200
# Results the AI judges per search.
JUDGE_CANDIDATES=30
# Candidates per AI request. Lower values (e.g. 15) judge in parallel batches: faster, but more requests per minute.
JUDGE_BATCH_SIZE=30
JUDGE_TIMEOUT_MS=20000
# An OpenAI-compatible model endpoint used alongside Gemini; OpenRouter by default. Leave the key empty to switch it off.
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=
# OpenRouter attributes requests to a site; both are optional and sent only when set.
OPENROUTER_SITE_URL=
OPENROUTER_SITE_NAME=
# Models that plan searches, in order: the first leads and the rest assist it, their queries merged into one
# capped list. Needs OPENROUTER_API_KEY. Empty leaves planning to Gemini, as before. When models are named,
# Gemini plans only if they all fail, so an ordinary search leaves its quota for judging and scene analysis.
# Pick for consistency, not headline speed: measure a candidate over repeated runs before trusting it.
PLANNER_MODELS=
# An assist that does not answer within this is left out, so a slow model cannot hold up a search. The first
# model is the primary and is awaited in full, bounded instead by JUDGE_TIMEOUT_MS.
PLANNER_ASSIST_TIMEOUT_MS=6000
# Gemini: used by the AI relevance judgement (candidate titles, descriptions and viewer comments are sent to Google) and by the
# optional scene worker (scene-worker/), which sends media only for sources whose policy sets video_analysis=true.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_TIMEOUT_SECONDS=600
# Absolute directory holding authorised local video and subtitle files.
SCENE_MEDIA_ROOT=
SCENE_MAX_MEDIA_SECONDS=2700
SCENE_MAX_UPLOAD_BYTES=2147483648
SCENE_ANALYSIS_DAILY_BUDGET=20
SCENE_LEASE_SECONDS=900
SCENE_POLL_SECONDS=5
# Speech-to-text fallback for local media without reusable subtitles; requires the optional transcribe extra.
SCENE_TRANSCRIBE_FALLBACK=false
# large-v3-turbo is larger and usually more accurate than small, but needs about 1.6 GB of disk and more RAM and CPU time.
# On a small CPU-only host, set small if transcription is too slow.
WHISPER_MODEL=large-v3-turbo
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
# Watchdog (npm run watchdog; docs/WATCHDOG.md): checks services, search engines, AI models, APIs, runtime tools and packages.
# API address to check; empty derives it from HOST and PORT. Set it when the watchdog runs on another host or container.
WATCHDOG_API_URL=
# Optional Slack or Discord incoming webhook; receives a message whenever a dependency's status changes.
WATCHDOG_WEBHOOK_URL=
# A service whose last heartbeat is older than this is reported as stopped.
WATCHDOG_STALE_SECONDS=90
# A search waiting this long for the worker is reported.
WATCHDOG_QUEUE_SECONDS=300
# Hours between checks for Node, package and SearXNG updates (vulnerabilities: at most every 12 hours).
WATCHDOG_UPDATE_HOURS=24
