{
  "name": "zenatlas-search-engine",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx src/main.ts",
    "worker": "node --env-file-if-exists=.env --import tsx src/worker-main.ts",
    "admin": "node --env-file-if-exists=.env --import tsx src/cli.ts",
    "migrate": "node --env-file-if-exists=.env --import tsx src/migrate.ts",
    "seed": "node --env-file-if-exists=.env --import tsx src/seed.ts",
    "build": "tsc --noEmit",
    "test": "node --import tsx --test --test-concurrency=1 tests/*.test.ts",
    "evaluate": "node --import tsx scripts/evaluate.ts",
    "preview": "node --import tsx scripts/preview.ts",
    "db:app-user": "node --env-file-if-exists=.env --import tsx scripts/app-user.ts",
    "start": "npm run dev"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/static": "^10.1.3",
    "fastify": "^5.12.4",
    "ipaddr.js": "^2.5.0",
    "pg": "^8.23.0",
    "playwright": "^1.63.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@types/node": "^26.6.0",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  }
}
